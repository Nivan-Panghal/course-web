# Copy this file to .env.test and fill it in. NEVER commit .env.test.
# Every variable here must exist in .env.test, even if empty. Next.js also reads
# .env.local (your LIVE settings) and only skips variables already set here.

# --- SAFETY GUARD: the project ref is the part before .supabase.co ---
TEST_SUPABASE_PROJECT_REF=
LIVE_SUPABASE_PROJECT_REF=

# --- kurso-test Supabase project ONLY ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App on the test port ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100
CRON_SECRET=test-cron-secret
LESSON_LINK_SECRET=test-lesson-link-secret-change-me
# Fresh value, NOT the live one (generated with the node command)
CREATOR_SECRETS_KEY=

# --- Storage (must point at a TEST bucket, never kurso-media) ---
R2_BUCKET_NAME=kurso-media-test

# --- Kurso's own Cashfree merchant account: SANDBOX only ---
KURSO_CASHFREE_CLIENT_ID=
KURSO_CASHFREE_CLIENT_SECRET=
KURSO_CASHFREE_ENV=sandbox
NEXT_PUBLIC_KURSO_CASHFREE_ENV=sandbox

# --- Leave empty so tests never send real emails or touch live services ---
RESEND_API_KEY=

# --- Creator gateway TEST keys (used from Phase 2) ---

